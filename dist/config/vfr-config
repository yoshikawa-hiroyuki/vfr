#!/bin/sh
# vfr-config : config-script for vfr-application

prefix=/usr/local/vfr
if [ -n "$VFRDIR" ]; then prefix="$VFRDIR"; fi

sys=Wx

usage="\
Usage: vfr-config [--prefix=<DIR>][--Wx|--SDL][--cflags][--libs]"

if test $# -eq 0; then
  echo "${usage}" 1>&2
  exit 1
fi

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *) optarg= ;;
  esac

  case $1 in
    --prefix=*)
      prefix=$optarg
      ;;
    --prefix)
      echo $prefix
      ;;
    --Wx)
      sys=Wx
      ;;
    --SDL)
      sys=SDL
      ;;
    --cflags)
      if test $sys = SDL ; then
        echo -I${prefix}/include `sdl-config --cflags`
      elif test $sys = Wx ; then
        #echo -I${prefix}/include `wx-config --unicode=no --cxxflags`
        echo -I${prefix}/include `wx-config --cxxflags`
      else
        echo -I${prefix}/include
      fi
      ;;
    --ldflags)
      libdirs="-L${prefix}/lib "
      echo $libdirs
      ;;
    --libs)
      if test $sys = SDL ; then
        if test `uname` = Darwin ; then
          echo ${prefix}/lib/libvfru.a ${prefix}/lib/libvfr.a ${prefix}/lib/libvfrSDL.a -lSDL_image -lm `sdl-config --libs`
#         echo -lvfrSDL -lvfru -lvfr -lSDL_image -lm `sdl-config --libs`
        else
          echo ${prefix}/lib/libvfru.a ${prefix}/lib/libvfr.a ${prefix}/lib/libvfrSDL.a -lSDL_image -lm `sdl-config --libs` -lGL -lGLU
#         echo -lvfrSDL -lvfru -lvfr -lSDL_image -lm `sdl-config --libs` -lGL -lGLU
        fi
      elif test $sys = Wx ; then
        #echo -lvfrWx -lvfru -lvfr `wx-config --unicode=no --static --libs core,base,net,gl,adv` -lm
        echo -lvfrWx -lvfru -lvfr `wx-config --libs core,base,net,gl,adv` -lm
      else
        echo -lvfru -lvfr -lm
      fi
      ;;
    *)
      echo "${usage}" 1>&2
      exit 1
      ;;
  esac
  shift
done
